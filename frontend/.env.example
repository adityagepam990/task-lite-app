# Base URL the app uses to reach the FastAPI backend (see /backend).
# On a physical device or Android emulator, "localhost" won't reach your
# computer -- use your machine's LAN IP or 10.0.2.2 (Android emulator) instead.
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws
