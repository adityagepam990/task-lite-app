# Optional environment overrides for the TaskLite backend.
#
# Copy to `.env` and edit. Values here beat config.toml but lose to real
# environment variables. Nested TOML keys map to flat, prefixed names using a
# double underscore for the section separator.
#
#   [server] port = 8000   ->   TASKLITE_SERVER__PORT=8000

# TASKLITE_APP__DEBUG=false
# TASKLITE_SERVER__HOST=0.0.0.0
# TASKLITE_SERVER__PORT=8000
# TASKLITE_DATABASE__PATH=tasklite.db
# TASKLITE_DATABASE__ECHO_SQL=true
# TASKLITE_SEED__ENABLED=false

# Note: to reach the backend from a physical phone running Expo Go, the server
# must listen on all interfaces, not just loopback:
#   TASKLITE_SERVER__HOST=0.0.0.0
# ...and the frontend's EXPO_PUBLIC_API_URL must point at your machine's LAN IP.
